# Normalise text to LF everywhere, including Windows checkouts.
* text=auto eol=lf

# Windows batch files need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.png  binary
*.ico  binary
*.icns binary
*.jpg  binary
*.gif  binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip  binary

# Generated files: collapse in diffs.
Cargo.lock       linguist-generated=true
pnpm-lock.yaml   linguist-generated=true
app/src/bindings/** linguist-generated=true
