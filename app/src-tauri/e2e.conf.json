{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "main",
        {
          "identifier": "e2e",
          "description": "End-to-end test builds only (--features e2e): lets WebdriverIO drive the app.",
          "windows": ["main"],
          "permissions": ["core:default", "wdio:default", "wdio-webdriver:default"]
        }
      ]
    }
  }
}
